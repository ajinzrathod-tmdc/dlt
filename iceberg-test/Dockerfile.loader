FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Install dlt with filesystem + iceberg + s3 support
RUN pip install --no-cache-dir \
    "dlt[filesystem,pyiceberg,s3,parquet]" \
    pandas

ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV ARROW_DEFAULT_MEMORY_POOL=system

# Parquet source data will be mounted as a volume
RUN mkdir -p /app/parquet_output

COPY test_large_parquet_docker.py .

CMD ["python", "test_large_parquet_docker.py"]
